  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  nextRetryAt DateTime?
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([status, lockedAt, nextRetryAt])
  @@index([eventType])
}

model ShoppingMemory {
