model CheckoutSagaState {
  checkoutId           String                   @id
  tenantId             String
  idempotencyKey       String
  requestFingerprint   String?
  traceId              String
  currentState         CheckoutSagaStateEnum
  pricingCompleted     Boolean                  @default(false)
  inventoryReserved    Boolean                  @default(false)
  orderCreated         Boolean                  @default(false)
  paymentAuthorized    Boolean                  @default(false)
  compensationRequired Boolean                  @default(false)
  lastEvent            CheckoutSagaEventEnum?
  lastError            String?
  version              Int                      @default(1)
  payload              Json?
  recoveryOwner        String?
  recoveryLeaseUntil   DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  transitions          CheckoutSagaTransition[]

  @@index([tenantId])
  @@unique([tenantId, idempotencyKey], name: "checkout_saga_tenant_idempotency_key")
}

model CheckoutSagaTransition {
  id            String                @id @default(uuid())
  checkoutId    String
  previousState CheckoutSagaStateEnum
  currentState  CheckoutSagaStateEnum
  event         CheckoutSagaEventEnum
  effect        String
  step          Int
  attempt       Int                   @default(1)
  timestamp     DateTime              @default(now())
  sagaState     CheckoutSagaState     @relation(fields: [checkoutId], references: [checkoutId])

  @@index([checkoutId])
}

