generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  clerkId                 String                   @unique
  email                   String                   @unique
  name                    String?
  role                    UserRole                 @default(CUSTOMER)
  loyaltyPoints           Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  addresses               Address[]
  auctionWatchlists       AuctionWatchlist[]
  bids                    Bid[]
  carts                   Cart[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  orders                  Order[]
  recentlyViewed          RecentlyViewed[]
  reviews                 Review[]
  savedSearches           SavedSearch[]
  tenantUsers             TenantUser[]
  wishlist                WishlistItem[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  street    String
  city      String
  state     String
  zip       String
  country   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([userId])
}

model Product {
  ownerTenantId      String?
  id                 String           @id @default(cuid())
  name               String
  description        String
  price              Decimal
  salePrice          Decimal?
  sku                String           @unique
  category           String
  brand              String
  stock              Int              @default(0)
  isTrending         Boolean          @default(false)
  rating             Float            @default(0)
  reviewCount        Int              @default(0)
  ratingDistribution Json?
  specs              Json?
  features           Json?
  healthScore        Int              @default(100)
  status             ProductStatus    @default(DRAFT)
  approvalStatus     String           @default("DRAFT")
  version            Int              @default(1)
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?
  deletedBy          String?
  deleteReason       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  auctions           Auction?
  cartItems          CartItem[]
  orderItems         OrderItem[]
  ownerTenant        Tenant?          @relation(fields: [ownerTenantId], references: [id])
  images             ProductImage[]
  variants           ProductVariant[]
  recentlyViewed     RecentlyViewed[]
  reviews            Review[]
  wishlistedBy       WishlistItem[]

  @@index([category])
  @@index([isTrending])
  @@index([status, category])
  @@index([brand, price])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  userId       String
  rating       Int
  title        String?
  content      String
  status       String   @default("PENDING")
  helpfulVotes Int      @default(0)
  sellerReply  String?
  aiRiskScore  Float    @default(0.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  type          String             @default("PERCENTAGE")
  discountValue Float
  minSubtotal   Float?
  maxDiscount   Float?
  isActive      Boolean            @default(true)
  expiresAt     DateTime?
  maxUses       Int?
  currentUses   Int                @default(0)
  tenantId      String             @default("system")
  version       Int                @default(1)
  createdAt     DateTime           @default(now())
  redemptions   CouponRedemption[]
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  orderId        String
  userId         String
  idempotencyKey String   @unique
  discountAmount Float
  createdAt      DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id])

  @@index([couponId, userId])
}

model Promotion {
  id                    String    @id @default(cuid())
  name                  String
  type                  String    @default("PERCENTAGE")
  discountValue         Float
  tenantId              String    @default("system")
  isActive              Boolean   @default(true)
  expiresAt             DateTime?
  minSubtotal           Float?
  applicableCategoryIds String[]
  createdAt             DateTime  @default(now())
}

model Order {
  id                    String           @id @default(cuid())
  userId                String
  idempotencyKey        String?          @unique
  totalAmount           Decimal
  subtotal              Decimal
  tax                   Decimal
  shippingCost          Decimal
  discount              Decimal          @default(0)
  status                OrderStatus      @default(PENDING)
  stripeId              String?          @unique
  stripeSessionId       String?          @unique
  stripePaymentIntentId String?          @unique
  currency              String           @default("USD")
  exchangeRate          Decimal          @default(1.0)
  shippingAddressId     String?
  version               Int              @default(1)
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenantId              String           @default("system")
  auction               Auction?
  invoice               Invoice?
  shippingAddress       Address?         @relation(fields: [shippingAddressId], references: [id])
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 OrderItem[]
  timelines             OrderTimeline[]
  paymentAttempts       PaymentAttempt[]
  vendorOrders          VendorOrder[]

  @@index([userId])
  @@index([status])
  @@index([userId, createdAt])
}

model DomainEventOutbox {
  id            String    @id @default(cuid())
  eventType     String
  payload       Json
  aggregateId   String
  aggregateType String
  published     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([published, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model StoreSettings {
  id               String   @id @default(cuid())
  storeName        String   @default("Nova Sphere")
  storeLogo        String?
  favicon          String?
  storeDescription String?
  contactEmail     String?
  supportEmail     String?
  businessPhone    String?
  facebookUrl      String?
  twitterUrl       String?
  instagramUrl     String?
  linkedinUrl      String?
  tiktokUrl        String?
  currency         String   @default("USD")
  taxRate          Decimal  @default(0)
  shippingRate     Decimal  @default(0)
  theme            String   @default("dark")
  primaryColor     String   @default("#3B82F6")
  secondaryColor   String   @default("#10B981")
  accentColor      String   @default("#D4A017")
  watermarkEnabled Boolean  @default(true)
  watermarkOpacity Float    @default(0.06)
  homepageLayout   Json?
  seoTitle         String?
  seoDescription   String?
  analyticsId      String?
  emailProvider    String?
  paymentGateway   String?
  updatedAt        DateTime @updatedAt
}

model SupportTicket {
  id             String          @id @default(cuid())
  userId         String?
  email          String
  subject        String
  status         TicketStatus    @default(OPEN)
  conversationId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversation   Conversation?   @relation(fields: [conversationId], references: [id])
  messages       TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([conversationId])
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  sender    TicketSender
  content   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Conversation {
  id           String                    @id @default(cuid())
  title        String?
  status       ConversationStatus        @default(ACTIVE)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  messages     ConversationMessage[]
  participants ConversationParticipant[]
  tickets      SupportTicket[]

  @@index([status])
}

model ConversationParticipant {
  id             String          @id @default(cuid())
  conversationId String
  userId         String
  role           ParticipantRole
  joinedAt       DateTime        @default(now())
  lastReadAt     DateTime?
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
}

model ConversationMessage {
  id             String                   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  deliveryState  MessageDeliveryState     @default(SENT)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  attachments    ConversationAttachment[]
  conversation   Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model ConversationAttachment {
  id        String              @id @default(cuid())
  messageId String
  fileUrl   String
  fileType  String
  fileName  String
  fileSize  Int
  createdAt DateTime            @default(now())
  message   ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Auction {
  ownerTenantId               String?
  id                          String             @id @default(cuid())
  productId                   String             @unique
  baseAmount                  Decimal
  baseCurrency                String             @default("USD")
  reservePrice                Decimal?
  reserveCurrency             String?
  buyNowPrice                 Decimal?
  currentBid                  Decimal            @default(0)
  highestBidderId             String?
  status                      AuctionStatus      @default(DRAFT)
  startTime                   DateTime?
  endTime                     DateTime
  antiSnipingEnabled          Boolean            @default(true)
  extensionMinutes            Int                @default(5)
  extensionThreshold          Int                @default(5)
  orderId                     String?            @unique
  antiSnipingWindowSeconds    Int?
  antiSnipingExtensionSeconds Int?
  antiSnipingMaxExtensions    Int?
  extensionsUsed              Int                @default(0)
  version                     Int                @default(1)
  createdBy                   String?
  updatedBy                   String?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  order                       Order?             @relation(fields: [orderId], references: [id])
  ownerTenant                 Tenant?            @relation(fields: [ownerTenantId], references: [id])
  product                     Product            @relation(fields: [productId], references: [id])
  watchers                    AuctionWatchlist[]
  bids                        Bid[]

  @@index([productId])
  @@index([status, endTime])
}

model Bid {
  id                   String    @id @default(cuid())
  auctionId            String
  userId               String
  amount               Decimal
  currency             String    @default("USD")
  exchangeRateSnapshot Decimal   @default(1.0)
  isProxyBid           Boolean   @default(false)
  maximumBid           Decimal?
  status               BidStatus @default(PENDING)
  createdAt            DateTime  @default(now())
  auction              Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([auctionId])
  @@index([userId])
}

model AuctionWatchlist {
  id               String   @id @default(cuid())
  userId           String
  auctionId        String
  notifyEndingSoon Boolean  @default(true)
  notifyOutbid     Boolean  @default(true)
  createdAt        DateTime @default(now())
  auction          Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, auctionId])
  @@index([userId])
  @@index([auctionId])
}

model BidLedger {
  id        String   @id @default(cuid())
  bidId     String
  auctionId String
  userId    String
  amount    Decimal
  currency  String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([bidId])
  @@index([auctionId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  filters   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
}

model SystemLog {
  id         String   @id @default(cuid())
  level      LogLevel
  source     String
  message    String
  stackTrace String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

model FeatureFlag {
  id                  String               @id @default(cuid())
  key                 String               @unique
  name                String
  description         String?
  category            String
  type                FeatureFlagType
  enabled             Boolean              @default(false)
  environment         String               @default("production")
  rolloutPercentage   Int                  @default(100)
  enabledForRoles     Json?
  enabledForCountries Json?
  enabledForUsers     Json?
  dependencies        Json?
  startDate           DateTime?
  endDate             DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  history             FeatureFlagHistory[]

  @@index([key])
  @@index([category])
}

model FeatureFlagHistory {
  id            String      @id @default(cuid())
  featureFlagId String
  oldValue      Json?
  newValue      Json?
  changedBy     String?
  reason        String?
  ipAddress     String?
  createdAt     DateTime    @default(now())
  flag          FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@index([featureFlagId])
}

model UserActivity {
  id           String   @id @default(cuid())
  userId       String?
  sessionId    String?
  activityType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())
}

model DailyAnalyticsSnapshot {
  id             String   @id @default(cuid())
  date           DateTime @unique
  revenue        Decimal  @default(0)
  orders         Int      @default(0)
  visitors       Int      @default(0)
  conversionRate Float    @default(0)
  topCategories  Json?
  createdAt      DateTime @default(now())
}

model Warehouse {
  ownerTenantId String?
  id            String      @id @default(cuid())
  name          String
  location      String?
  inventories   Inventory[]
  ownerTenant   Tenant?     @relation(fields: [ownerTenantId], references: [id])
}

model Inventory {
  id           String              @id @default(cuid())
  productId    String              @unique
  warehouseId  String
  quantity     Int                 @default(0)
  reserved     Int                 @default(0)
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  movements    InventoryMovement[]
  reservations Reservation[]
}

model InventoryMovement {
  id             String    @id @default(cuid())
  inventoryId    String
  type           String
  quantity       Int
  beforeQuantity Int       @default(0)
  afterQuantity  Int       @default(0)
  reason         String?
  referenceId    String?
  performedBy    String?
  source         String?
  notes          String?
  createdAt      DateTime  @default(now())
  inventory      Inventory @relation(fields: [inventoryId], references: [id])
}

model Reservation {
  id          String    @id @default(cuid())
  inventoryId String
  orderId     String
  quantity    Int
  status      String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
}

model OrderTimeline {
  id            String   @id @default(cuid())
  orderId       String
  status        String
  previousState String?
  newState      String?
  actor         String   @default("SYSTEM")
  reason        String?
  message       String?
  metadata      Json?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id])
}

model Notification {
  id                String               @id @default(cuid())
  userId            String
  type              NotificationType
  priority          NotificationPriority @default(MEDIUM)
  title             String
  message           String
  link              String?
  metadata          Json?
  isRead            Boolean              @default(false)
  readAt            DateTime?
  isArchived        Boolean              @default(false)
  channel           String?
  provider          String?
  providerMessageId String?
  sentAt            DateTime?
  status            String               @default("PENDING")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  inApp     Boolean          @default(true)
  email     Boolean          @default(true)
  push      Boolean          @default(false)
  sms       Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model BusinessRule {
  id             String          @id @default(cuid())
  name           String
  description    String?
  priority       Int             @default(0)
  scope          String
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  isActive       Boolean         @default(true)
  regions        String[]
  customerGroups String[]
  isStackable    Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  actions        RuleAction[]
  conditions     RuleCondition[]

  @@index([scope, isActive])
}

model RuleCondition {
  id       String       @id @default(cuid())
  ruleId   String
  field    String
  operator String
  value    String
  rule     BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

model RuleAction {
  id      String       @id @default(cuid())
  ruleId  String
  type    String
  payload String
  rule    BusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

model ContentLayout {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  structure   String
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sections    ContentSection[]
}

model ContentSection {
  id         String             @id @default(cuid())
  layoutId   String
  type       String
  order      Int                @default(0)
  config     String
  components ContentComponent[]
  layout     ContentLayout      @relation(fields: [layoutId], references: [id], onDelete: Cascade)
}

model ContentComponent {
  id        String         @id @default(cuid())
  sectionId String
  type      String
  data      String
  section   ContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Asset {
  id         String   @id @default(cuid())
  url        String
  provider   String   @default("CLOUDINARY")
  providerId String?
  format     String
  width      Int?
  height     Int?
  size       Int?
  altText    String?
  createdAt  DateTime @default(now())
}

model Experiment {
  id          String                 @id @default(cuid())
  key         String                 @unique
  name        String
  description String?
  status      String                 @default("DRAFT")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  allocations ExperimentAllocation[]
  variants    ExperimentVariant[]
}

model ExperimentVariant {
  id           String                 @id @default(cuid())
  experimentId String
  name         String
  weight       Int
  payload      String
  allocations  ExperimentAllocation[]
  experiment   Experiment             @relation(fields: [experimentId], references: [id], onDelete: Cascade)
}

model ExperimentAllocation {
  id           String            @id @default(cuid())
  experimentId String
  variantId    String
  userId       String
  createdAt    DateTime          @default(now())
  experiment   Experiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant      ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, userId])
}

model Tenant {
  id               String            @id @default(cuid())
  name             String
  plan             String            @default("BASIC")
  status           String            @default("PENDING")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  auctions         Auction[]
  commissionPolicy CommissionPolicy?
  kycProfile       KYCProfile?
  products         Product[]
  store            Store?
  users            TenantUser[]
  vendorOrders     VendorOrder[]
  wallets          VendorWallet?
  warehouses       Warehouse[]
}

model Store {
  id              String      @id @default(cuid())
  tenantId        String      @unique
  name            String
  slug            String      @unique
  logoUrl         String?
  bannerUrl       String?
  themeColor      String?
  defaultCurrency String      @default("USD")
  returnPolicy    String?
  shippingPolicy  String?
  status          StoreStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

model VendorWallet {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  pendingBalance   Decimal  @default(0)
  availableBalance Decimal  @default(0)
  reservedBalance  Decimal  @default(0)
  paidBalance      Decimal  @default(0)
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model KYCProfile {
  id              String    @id @default(cuid())
  tenantId        String    @unique
  businessType    String
  taxId           String?
  legalName       String
  identityDocUrl  String?
  businessDocUrl  String?
  status          KYCStatus @default(DRAFT)
  aiRiskScore     Int?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CommissionPolicy {
  id         String   @id @default(cuid())
  tenantId   String?  @unique
  percentage Decimal  @default(10.0)
  fixedFee   Decimal  @default(0.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model VendorOrder {
  id                 String            @id @default(cuid())
  orderId            String
  tenantId           String
  amountBase         Decimal
  baseCurrency       String            @default("USD")
  amountSettlement   Decimal
  settlementCurrency String
  exchangeRateUsed   Decimal?
  subtotal           Decimal
  tax                Decimal           @default(0)
  shipping           Decimal           @default(0)
  status             String            @default("PENDING")
  settlementStatus   SettlementStatus  @default(PENDING)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  shipments          Shipment[]
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  items              VendorOrderItem[]
}

model VendorOrderItem {
